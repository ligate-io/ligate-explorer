# Toggle between typed mock fixtures and the live API.
# Set to `false` to fetch from $NEXT_PUBLIC_API_URL.
USE_MOCK_API=true

# Live API root (used when USE_MOCK_API=false).
NEXT_PUBLIC_API_URL=https://api.ligate.io

# Public chain RPC root, surfaced in the UI for copy-paste.
NEXT_PUBLIC_RPC_URL=https://rpc.ligate.io
