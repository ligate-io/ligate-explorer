# syntax=docker/dockerfile:1.7

# Build stage. Pinned to the same Rust version as the chain repo
# (rust-toolchain.toml: 1.93.0) so transient build differences don't
# surprise us in CI vs Railway.
FROM rust:1.93-bookworm AS builder

WORKDIR /build

# Copy workspace manifests first so the dependency layer caches across
# source-only edits.
COPY Cargo.toml Cargo.lock* ./
COPY rust-toolchain.toml ./
COPY crates/types/Cargo.toml crates/types/Cargo.toml
COPY crates/indexer/Cargo.toml crates/indexer/Cargo.toml

RUN mkdir -p crates/types/src crates/indexer/src \
    && echo "fn main() {}" > crates/indexer/src/main.rs \
    && echo "" > crates/types/src/lib.rs \
    && cargo build --release --bin ligate-indexer || true

# Now copy the real sources and build for real.
COPY crates ./crates

RUN touch crates/indexer/src/main.rs crates/types/src/lib.rs \
    && cargo build --release --bin ligate-indexer

# Runtime stage. Slim Debian with the binary and a non-root user.
FROM debian:bookworm-slim AS runtime

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --user-group --create-home --shell /usr/sbin/nologin ligate

COPY --from=builder /build/target/release/ligate-indexer /usr/local/bin/ligate-indexer
COPY crates/indexer/migrations /opt/ligate/migrations

USER ligate
WORKDIR /home/ligate

# Indexer reads RPC_URL, DATABASE_URL, START_HEIGHT, BACKFILL_CONCURRENCY
# from env. Set them at deploy time.
ENTRYPOINT ["/usr/local/bin/ligate-indexer"]
